# Registered Fanvue app credentials. Never commit their real values.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-domain.example/oauth/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
# Must match public/app-manifest.json and src/workspace/oauth-scopes.ts.
OAUTH_SCOPES=read:self read:media read:chat read:fan read:insights read:creator write:chat

# Used by readiness checks and the future encrypted background token store.
FANVUE_APP_UUID=
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_OAUTH_REDIRECT_URI=https://your-domain.example/oauth/callback
FANVUE_APP_BASE_URL=https://your-domain.example
FANVUE_WEBHOOK_SIGNATURE_PROFILE=fanvue-v0

# Deployment and capability controls. Keep writes disabled by default.
PERFORM_ENV=local
PERFORM_WRITE_MODE=disabled
PERFORM_DEMO_CREATOR_UUIDS=
PERFORM_DEMO_CREATOR_HANDLES=

# Leave production defaults unchanged unless Fanvue gives you dev access.
FANVUE_API_VERSION=2025-06-26
